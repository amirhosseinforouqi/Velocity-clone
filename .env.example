# Copy to .env.local for local development, and set the same names in Vercel (Production and Preview).
# Never commit real values. The service-role key and every secret below are server-only.

# Signs session cookies, upload links and the sealed MFA secrets. Generate with: npx auth secret
AUTH_SECRET=
# Needed when not deployed on Vercel.
AUTH_TRUST_HOST=true
# Public base URL used in invitation emails, e.g. https://keyway.example.com (Vercel's production URL is used if unset).
APP_URL=
# Time zone for dates in emails (default America/Toronto).
TIME_ZONE=

# Local only: where the PGlite database and uploads live (defaults under .data/).
PGLITE_DIR=
UPLOAD_DIR=

# Supabase Postgres. Unset = local PGlite. Use the transaction pooler (port 6543) for the app;
# use the session pooler or direct connection (port 5432) when running npm run db:migrate.
DATABASE_URL=
# Supabase private Storage for client documents. Unset = files on local disk (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=client-documents

# Resend transactional email. Unset = nothing is emailed; staff see the invitation link instead.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Keyway <portal@mail.example.com>".
EMAIL_FROM=
# Signing secret of the Resend webhook pointed at /api/webhooks/resend (delivery, bounce, complaint).
RESEND_WEBHOOK_SECRET=

# Malware scanner: uploads are POSTed here (raw bytes) and it must answer {"infected": true|false}.
# Unset = uploads are quarantined until a firm admin releases them.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Protects the daily retention job (/api/cron/retention). Vercel Cron sends it automatically.
CRON_SECRET=
